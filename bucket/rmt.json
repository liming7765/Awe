{
    "version": "1.2.1",
    "description": "RMT (RuoMengTu) is a free, open-source macro tool built on AHKv2. Let the code handle the tedious work—you have more meaningful things to do.",
    "homepage": "https://github.com/zclucas/RMT",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zclucas/RMT/releases/download/RMTv1.2.1/RMTv1.2.1_x64.zip",
            "hash": "8102b49480437668c80f42fced8d874935d43fbfee4690a7e8fb89d662bf887d"
        },
        "32bit": {
            "url": "https://github.com/zclucas/RMT/releases/download/RMTv1.2.1/RMTv1.2.1_x86.zip",
            "hash": "97f61e5b551fe167813a04353a622ede89ca58384aff044abc11804f9ce20d2c"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\RMTv*.exe\" | Rename-Item -NewName 'RMT.exe' -ErrorAction SilentlyContinue",
        "if (!(Test-Path \"$dir\\SettingOld\")) { New-Item \"$dir\\SettingOld\" -Type Directory }"
    ],
    "bin": "RMT.exe",
    "shortcuts": [
        [
            "RMT.exe",
            "RMT"
        ]
    ],
    "persist": [
        "Setting",
        "SettingOld"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/zclucas/RMT/tags?per_page=1",
        "jsonpath": "$[0].name",
        "regex": "^RMTv([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zclucas/RMT/releases/download/RMTv$version/RMTv$version_x64.zip"
            },
            "32bit": {
                "url": "https://github.com/zclucas/RMT/releases/download/RMTv$version/RMTv$version_x86.zip"
            }
        }
    }
}
