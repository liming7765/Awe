
{
    "version": "1.2.2",
    "description": "RMT (RuoMengTu) is a free, open-source macro automation tool based on AutoHotkey v2.",
    "homepage": "https://github.com/zclucas/RMT",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zclucas/RMT/releases/download/RMTv1.2.2/RMTv1.2.2_x64.zip",
            "hash": "a715290804b4bb5f6f3c690265ccc3864a4a9a303d3990b41a63ebd75544165e"
        },
        "32bit": {
            "url": "https://github.com/zclucas/RMT/releases/download/RMTv1.2.2/RMTv1.2.2_x86.zip",
            "hash": "df65b4b7f0d14ae6ed2e176a57d655d2eb9ca2b4303bcb3a48e737a514895ebb"
        }
    },
    "pre_install": [
        "$exe = Join-Path $dir \"RMTv$version.exe\"",
        "if (!(Test-Path -LiteralPath $exe)) { throw \"Missing expected executable: $exe\" }",
        "Rename-Item -LiteralPath $exe -NewName 'RMT.exe' -ErrorAction Stop",
        "foreach ($name in @('Setting', 'SettingOld')) { $path = Join-Path $dir $name; if (!(Test-Path -LiteralPath $path)) { New-Item -ItemType Directory -Path $path -Force | Out-Null } }"
    ],
    "bin": "RMT.exe",
    "shortcuts": [
        [
            "RMT.exe",
            "RMT"
        ]
    ],
    "persist": [
        "Setting",
        "SettingOld"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/zclucas/RMT/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^RMTv([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zclucas/RMT/releases/download/RMTv$version/RMTv$version_x64.zip"
            },
            "32bit": {
                "url": "https://github.com/zclucas/RMT/releases/download/RMTv$version/RMTv$version_x86.zip"
            }
        }
    }
}
