{
    "version": "2026.11.23",
    "description": "Honkai: Star Rail automation tool",
    "homepage": "https://m7a.top/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/moesnow/March7thAssistant/releases/download/v2026.11.23/March7thAssistant_full.7z",
            "hash": "7c8d978f0fc50da797d26b46e2854e56b3792267c4c1c1fed169ed3d948827f7",
            "extract_dir": "March7thAssistant_full"
        }
    },
    "bin": [
        "March7th Launcher.exe",
        "m7a.exe"
    ],
    "shortcuts": [
        [
            "March7th Launcher.exe",
            "March7th Launcher"
        ]
    ],
    "persist": [
        "config",
        "settings",
        "logs",
        "screenshots",
        "3rdparty/WebBrowser/UserProfile"
    ],
    "pre_install": [
        "ensure \"$dir\\3rdparty\\WebBrowser\" | Out-Null",
        "foreach ($name in @('config.yaml', 'warp.json', 'characters.json', 'characters.partial.json')) {",
        "    $source = Join-Path $persist_dir $name",
        "    if (Test-Path -LiteralPath $source -PathType Leaf) {",
        "        Copy-Item -LiteralPath $source -Destination (Join-Path $dir $name) -Force -ErrorAction Stop",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "ensure $persist_dir | Out-Null",
        "foreach ($name in @('config.yaml', 'warp.json', 'characters.json', 'characters.partial.json')) {",
        "    $source = Join-Path $dir $name",
        "    if (Test-Path -LiteralPath $source -PathType Leaf) {",
        "        Copy-Item -LiteralPath $source -Destination (Join-Path $persist_dir $name) -Force -ErrorAction Stop",
        "    }",
        "}",
        "Get-ChildItem -LiteralPath $dir -File | Where-Object { $_.Name -match '^config\\.yaml\\.(bak(?:-.*)?|prefallback)$' } | ForEach-Object {",
        "    Copy-Item -LiteralPath $_.FullName -Destination $persist_dir -Force -ErrorAction Stop",
        "}"
    ],
    "notes": [
        "Close March7thAssistant before upgrading.",
        "Use 'scoop update march7thassistant' instead of the application's built-in updater.",
        "After upgrading, recreate any autostart task that points to an old version directory."
    ],
    "checkver": {
        "url": "https://api.github.com/repos/moesnow/March7thAssistant/releases/latest",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moesnow/March7thAssistant/releases/download/v$version/March7thAssistant_full.7z",
                "extract_dir": "March7thAssistant_full"
            }
        }
    }
}
