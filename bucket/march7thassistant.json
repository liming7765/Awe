
{
    "version": "2026.11.15",
    "description": "Honkai: Star Rail automation tool",
    "homepage": "https://m7a.top/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/moesnow/March7thAssistant/releases/download/v2026.11.15/March7thAssistant_full.7z",
            "hash": "21fdb647dfb57dab6bee1064ad5c847dcb77f5476cef5a0eecf0e535914bb679",
            "extract_dir": "March7thAssistant_full"
        }
    },
    "bin": "March7th Launcher.exe",
    "shortcuts": [
        [
            "March7th Launcher.exe",
            "March7th Launcher"
        ]
    ],
    "persist": [
        "config",
        "settings",
        "logs"
    ],
    "pre_install": [
        "ensure $persist_dir | Out-Null",
        "foreach ($name in @('config.yaml', 'warp.json')) {",
        "    $source = Join-Path $persist_dir $name",
        "    $destination = Join-Path $dir $name",
        "    if (Test-Path -LiteralPath $source -PathType Leaf) {",
        "        Copy-Item -LiteralPath $source -Destination $destination -Force -ErrorAction Stop",
        "    }",
        "}"
    ],
    "pre_uninstall": [
        "ensure $persist_dir | Out-Null",
        "foreach ($name in @('config.yaml', 'warp.json')) {",
        "    $source = Join-Path $dir $name",
        "    $destination = Join-Path $persist_dir $name",
        "    if (Test-Path -LiteralPath $source -PathType Leaf) {",
        "        Copy-Item -LiteralPath $source -Destination $destination -Force -ErrorAction Stop",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/moesnow/March7thAssistant/releases/latest",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moesnow/March7thAssistant/releases/download/v$version/March7thAssistant_full.7z",
                "extract_dir": "March7thAssistant_full"
            }
        }
    }
}
